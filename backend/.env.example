# Puerto HTTP de la API
PORT=8000
# Ruta a la base de datos (por defecto ../data/health_monitor.sqlite)
DB_PATH=../data/health_monitor.sqlite
# Origen permitido para CORS (frontend de Vite en desarrollo)
CORS_ORIGIN=http://localhost:5173
# true: desplaza las marcas de tiempo para que las últimas 24 h terminen "ahora"
TIME_SHIFT=true
